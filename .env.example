# Application Settings
ENVIRONMENT=development
DEBUG=true
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://parabox:parabox_password@localhost:5432/parabox_dev
DATABASE_POOL_SIZE=20
DATABASE_POOL_OVERFLOW=20
DATABASE_POOL_TIMEOUT=60
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false

# Redis Cache & Queues
REDIS_URL=redis://localhost:6379/0

# Identity & Authentication (Supabase Auth / JWT)
# In local development without Supabase, set SUPABASE_JWT_SECRET or use mock tokens
SUPABASE_URL=
SUPABASE_JWT_SECRET=parabox-development-jwt-secret-min-32-chars
AUTH_API_KEY_PREFIX=pb_live_

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRICE_HOBBY=price_hobby
STRIPE_PRICE_PRO=price_pro

# LLM Gateway Providers
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_VISION_MODEL=anthropic/claude-3.5-sonnet
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Storage (S3 / Cloudflare R2 / Supabase Storage / MinIO)
STORAGE_ENDPOINT=localhost:9000
STORAGE_BUCKET=parabox-artifacts
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false

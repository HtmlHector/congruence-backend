# ==============================================================================
# Parabox Backend Starter - Environment Configuration
# ==============================================================================

# Application
APP_ENVIRONMENT=development
APP_DEBUG=true
APP_API_PREFIX=/api/v1
APP_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]
APP_HOST=0.0.0.0
APP_PORT=8001
# Public origin of this API; OAuth callbacks are built from it, so it must match
# the callback URL registered on each provider (e.g. the GitHub App).
APP_PUBLIC_API_URL=http://localhost:8001
# Web app origin; OAuth callbacks redirect the browser back here when done.
APP_WEB_APP_URL=http://localhost:3000

# PostgreSQL (pgvector/pg16)
DATABASE_URL=postgresql+asyncpg://parabox:parabox@localhost:5432/parabox_dev
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false
DATABASE_ENABLE_RLS=true

# Redis Cache & Realtime
REDIS_URL=redis://localhost:6379/0

# RabbitMQ Message Broker
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE_NAME=parabox.events

# S3 / MinIO Object Storage
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=parabox-storage
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Symmetric encryption key for integration tokens, env vars, and agent credentials.
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Clerk Authentication (matches frontend Starter NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY)
# Leave as placeholders for local dev: tokens are decoded without signature checks.
# With real keys, the JWKS URL is derived from CLERK_PUBLISHABLE_KEY automatically
# (override with CLERK_JWKS_URL if your instance uses a custom JWKS endpoint).
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_JWKS_URL=
CLERK_WEBHOOK_SECRET=whsec_placeholder

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRO_PRICE_ID=price_pro_placeholder
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_placeholder

# Transactional Email (Resend)
EMAIL_API_KEY=re_placeholder
EMAIL_FROM_ADDRESS=notifications@parabox.so

# Third-Party Integrations & OAuth
INTEGRATIONS_GITHUB_CLIENT_ID=gh_client_id_placeholder
INTEGRATIONS_GITHUB_CLIENT_SECRET=gh_client_secret_placeholder
INTEGRATIONS_GITHUB_WEBHOOK_SECRET=gh_webhook_secret_placeholder
INTEGRATIONS_GITLAB_CLIENT_ID=gitlab_client_id_placeholder
INTEGRATIONS_GITLAB_CLIENT_SECRET=gitlab_client_secret_placeholder
INTEGRATIONS_GITLAB_WEBHOOK_SECRET=gitlab_webhook_secret_placeholder
INTEGRATIONS_BITBUCKET_CLIENT_ID=bitbucket_client_id_placeholder
INTEGRATIONS_BITBUCKET_CLIENT_SECRET=bitbucket_client_secret_placeholder
INTEGRATIONS_SLACK_CLIENT_ID=slack_client_id_placeholder
INTEGRATIONS_SLACK_CLIENT_SECRET=slack_client_secret_placeholder
INTEGRATIONS_LINEAR_CLIENT_ID=linear_client_id_placeholder
INTEGRATIONS_LINEAR_CLIENT_SECRET=linear_client_secret_placeholder
INTEGRATIONS_STATE_SIGNING_KEY=parabox-oauth-signing-secret-key-123

# Congruence devboxes (fly | e2b | local | memory)
# local = one Docker container per project; build it once with `make devbox-image`.
# memory = no container (tests/demos); fly = remote Fly Machines.
DEVBOX_PROVIDER=local
# Docker CLI override when it is not on PATH (Docker Desktop installs it here).
# DEVBOX_DOCKER_BIN=/Applications/Docker.app/Contents/Resources/bin/docker
DEVBOX_IMAGE_REF=congruence/devbox:dev
DEVBOX_REGION=iad
DEVBOX_IDLE_PAUSE_SECONDS=900
DEVBOX_MAX_TERMINALS_PER_WORKTREE=8
DEVBOX_CAPTURE_TOKEN_SECRET=devbox-capture-secret-placeholder

# Fly Machines provider
FLY_API_TOKEN=placeholder
FLY_APP_NAME=congruence-devboxes

# Terminal gateway
GATEWAY_TICKET_SECRET=gateway-ticket-secret-placeholder
GATEWAY_TICKET_TTL_SECONDS=60

# Preview routing
PREVIEW_DOMAIN=preview.congruence.dev
PREVIEW_COOKIE_SECRET=preview-cookie-secret-placeholder

# Plan entitlements (included hours / awake boxes)
LIMITS_TRIAL_HOURS=20
LIMITS_STARTER_HOURS=50
LIMITS_PRO_HOURS=250
LIMITS_MAX_HOURS=600

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV TERM=xterm-256color
ENV COLORTERM=truecolor

# Install system utilities, git, zsh, build tools, python, curl, ca-certificates
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    zsh \
    bash \
    curl \
    ca-certificates \
    build-essential \
    python3 \
    python3-pip \
    python3-venv \
    procps \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 22 & npm
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g pnpm yarn \
    && rm -rf /var/lib/apt/lists/*

# Install uv (fast Python packaging tool)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && cp /root/.local/bin/uv* /usr/local/bin/ 2>/dev/null || true

# Install Claude Code CLI
RUN npm install -g @anthropic-ai/claude-code || true

# Install official Google Antigravity CLI (agy)
RUN curl -fsSL --compressed https://antigravity.google/cli/install.sh | bash -s -- -d /usr/local/bin \
    && chmod +x /usr/local/bin/agy 2>/dev/null || true

# Install OpenAI Codex and OpenCode CLI harnesses
COPY scripts/opencode_cli.py /usr/local/bin/opencode
COPY scripts/codex_cli.py /usr/local/bin/codex
RUN chmod +x /usr/local/bin/opencode /usr/local/bin/codex

# Set up git safe directory and clean zsh/bash prompts
RUN git config --system --add safe.directory "*" \
    && mkdir -p /etc/zsh \
    && echo 'export PROMPT="%F{cyan}➜ %F{green}%~%F{yellow} [container] %F{reset}%% "' >> /etc/zsh/zshrc \
    && echo 'export PROMPT="%F{cyan}➜ %F{green}%~%F{yellow} [container] %F{reset}%% "' >> /root/.zshrc \
    && echo 'export PS1="\[\033[01;32m\]➜ \[\033[01;34m\]\w \[\033[01;33m\][container]\[\033[00m\]\$ "' >> /etc/bash.bashrc \
    && echo 'export PS1="\[\033[01;32m\]➜ \[\033[01;34m\]\w \[\033[01;33m\][container]\[\033[00m\]\$ "' >> /root/.bashrc

WORKDIR /workspaces

CMD ["sleep", "infinity"]

